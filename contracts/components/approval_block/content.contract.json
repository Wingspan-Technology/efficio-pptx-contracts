{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "component_type": "approval_block",
  "description": "Expected AI output for an approval block. null leaves the block unchanged; an object selects an approval subtype and fills the approver name and role.",
  "type": ["null", "object"],
  "additionalProperties": false,
  "required": ["subtype", "name", "role"],
  "properties": {
    "subtype": {
      "type": "string",
      "enum": ["recommended", "endorsed", "approved"],
      "description": "Selected approval subtype."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Approver name."
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "description": "Approver role/title."
    }
  }
}
