{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["selected_slides"],
  "properties": {
    "selected_slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slide_id"],
        "properties": {
          "slide_id": {
            "type": "string",
            "minLength": 1
          },
          "selection_reason": {
            "type": "string",
            "maxLength": 300
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
