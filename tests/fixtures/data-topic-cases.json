  "resolution_cases": [
    {
      "name": "slide without an assignment against a populated registry",
      "deck_tags": {
        "efficio_data_topics": "[{\"topic_id\": \"topic_revenue\", \"name\": \"Revenue\"}, {\"topic_id\": \"topic_customer_churn\", \"name\": \"Customer churn\"}, {\"topic_id\": \"topic_headcount\", \"name\": \"Headcount\"}]"
      },
      "slide_tags": {
        "efficio_slide_id": "slide_001"
      },
      "expected": []
    },
    {
      "name": "slide without an assignment against a missing registry",
      "deck_tags": {},
      "slide_tags": {
        "efficio_slide_id": "slide_001"
      },
      "expected": []
    },
    {
      "name": "slide without an assignment does not consult the deck registry",
      "deck_tags": {
        "efficio_data_topics": "[{\"topic_id\":\"topic_revenue\",\"name\":\"A\"},{\"topic_id\":\"topic_revenue\",\"name\":\"B\"}]"
      },
      "slide_tags": {
        "efficio_slide_id": "slide_001"
      },
      "expected": []
    },
    {
      "name": "one assigned data topic resolves to its definition",
      "deck_tags": {
        "efficio_data_topics": "[{\"topic_id\": \"topic_revenue\", \"name\": \"Revenue\"}, {\"topic_id\": \"topic_customer_churn\", \"name\": \"Customer churn\"}, {\"topic_id\": \"topic_headcount\", \"name\": \"Headcount\"}]"
      },
      "slide_tags": {
        "efficio_slide_data_topic_ids": "[\"topic_customer_churn\"]"
      },
      "expected": [
        {
          "topic_id": "topic_customer_churn",
          "name": "Customer churn"
        }
      ]
    },
    {
      "name": "assignment order wins over registry order",
      "deck_tags": {
        "efficio_data_topics": "[{\"topic_id\": \"topic_revenue\", \"name\": \"Revenue\"}, {\"topic_id\": \"topic_customer_churn\", \"name\": \"Customer churn\"}, {\"topic_id\": \"topic_headcount\", \"name\": \"Headcount\"}]"
      },
      "slide_tags": {
        "efficio_slide_data_topic_ids": "[\"topic_headcount\",\"topic_revenue\"]"
      },
      "expected": [
        {
          "topic_id": "topic_headcount",
          "name": "Headcount"
        },
        {
          "topic_id": "topic_revenue",
          "name": "Revenue"
        }
      ]
    },
    {
      "name": "topics sharing a name resolve by ID",
      "deck_tags": {
        "efficio_data_topics": "[{\"topic_id\":\"topic_revenue_eu\",\"name\":\"Revenue\"},{\"topic_id\":\"topic_revenue_us\",\"name\":\"Revenue\"}]"
      },
      "slide_tags": {
        "efficio_slide_data_topic_ids": "[\"topic_revenue_us\"]"
      },
      "expected": [
        {
          "topic_id": "topic_revenue_us",
          "name": "Revenue"
        }
      ]
    },
    {
      "name": "unicode names resolve unchanged",
      "deck_tags": {
        "efficio_data_topics": "[{\"topic_id\": \"topic_umsatz\", \"name\": \"Umsatz – Région Île-de-France\"}, {\"topic_id\": \"topic_sales_jp\", \"name\": \"売上高\"}]"
      },
      "slide_tags": {
        "efficio_slide_data_topic_ids": "[\"topic_sales_jp\",\"topic_umsatz\"]"
      },
      "expected": [
        {
          "topic_id": "topic_sales_jp",
          "name": "売上高"
        },
        {
          "topic_id": "topic_umsatz",
          "name": "Umsatz – Région Île-de-France"
        }
      ]
