{
  "comment": "Shared TypeScript/Python data-topic cases. `null` stands for an absent tag value; a string is stored PowerPoint tag text; an array is an already-decoded value.",
  "registry_cases": [
    {
      "name": "Unicode next-line and separator characters are blank registry values",
      "raw": "\u0085\u001c\u001d\u001e\u001f",
      "expected": []
    },
    {
      "name": "Unicode next-line and separators are trimmed from names",
      "raw": [{"topic_id": "topic_revenue", "name": "\u0085\u001cRevenue\u001f\u0085"}],
      "expected": [{"topic_id": "topic_revenue", "name": "Revenue"}]
    },
    {
      "name": "byte-order marks in names are not silently removed",
      "raw": [{"topic_id": "topic_revenue", "name": "\ufeffRevenue\ufeff"}],
      "expected": [{"topic_id": "topic_revenue", "name": "\ufeffRevenue\ufeff"}]
    },
    {
      "name": "missing registry declares no data topics",
      "raw": null,
      "expected": []
    },
    {
      "name": "blank registry declares no data topics",
      "raw": "   ",
      "expected": []
    },
    {
      "name": "empty stored array declares no data topics",
      "raw": "[]",
      "expected": []
    },
    {
      "name": "empty decoded array declares no data topics",
      "raw": [],
      "expected": []
    },
    {
      "name": "one data topic",
      "raw": "[{\"topic_id\":\"topic_revenue\",\"name\":\"Revenue\"}]",
      "expected": [
        {
          "topic_id": "topic_revenue",
          "name": "Revenue"
        }
      ]
    },
    {
      "name": "multiple data topics keep authored order",
      "raw": "[{\"topic_id\": \"topic_revenue\", \"name\": \"Revenue\"}, {\"topic_id\": \"topic_customer_churn\", \"name\": \"Customer churn\"}, {\"topic_id\": \"topic_headcount\", \"name\": \"Headcount\"}]",
      "expected": [
        {
          "topic_id": "topic_revenue",
          "name": "Revenue"
        },
        {
          "topic_id": "topic_customer_churn",
          "name": "Customer churn"
        },
        {
          "topic_id": "topic_headcount",
          "name": "Headcount"
        }
      ]
    },
    {
      "name": "an already-decoded array is accepted",
      "raw": [
        {
          "topic_id": "topic_revenue",
          "name": "Revenue"
        },
        {
          "topic_id": "topic_customer_churn",
          "name": "Customer churn"
        }
      ],
      "expected": [
        {
          "topic_id": "topic_revenue",
          "name": "Revenue"
        },
        {
          "topic_id": "topic_customer_churn",
          "name": "Customer churn"
        }
      ]
    },
    {
      "name": "names may repeat when topic IDs are unique",
      "raw": "[{\"topic_id\":\"topic_revenue_eu\",\"name\":\"Revenue\"},{\"topic_id\":\"topic_revenue_us\",\"name\":\"Revenue\"}]",
      "expected": [
        {
          "topic_id": "topic_revenue_eu",
          "name": "Revenue"
        },
        {
          "topic_id": "topic_revenue_us",
          "name": "Revenue"
        }
      ]
    },
    {
      "name": "names are trimmed while IDs stay exact",
      "raw": "[{\"topic_id\":\"topic_revenue\",\"name\":\"  Revenue  \"}]",
      "expected": [
        {
          "topic_id": "topic_revenue",
          "name": "Revenue"
        }
      ]
    },
    {
      "name": "names are trimmed of non-breaking and ideographic spaces",
      "raw": "[{\"topic_id\":\"topic_revenue\",\"name\":\" Revenue　\"}]",
      "expected": [
        {
          "topic_id": "topic_revenue",
          "name": "Revenue"
        }
      ]
    },
    {
      "name": "unicode names are preserved exactly",
      "raw": "[{\"topic_id\": \"topic_umsatz\", \"name\": \"Umsatz – Région Île-de-France\"}, {\"topic_id\": \"topic_sales_jp\", \"name\": \"売上高\"}, {\"topic_id\": \"topic_kpis\", \"name\": \"📊 KPIs\"}, {\"topic_id\": \"topic_cafe\", \"name\": \"Café sales\"}]",
      "expected": [
        {
          "topic_id": "topic_umsatz",
          "name": "Umsatz – Région Île-de-France"
        },
        {
          "topic_id": "topic_sales_jp",
          "name": "売上高"
        },
        {
          "topic_id": "topic_kpis",
          "name": "📊 KPIs"
        },
        {
          "topic_id": "topic_cafe",
          "name": "Café sales"
        }
      ]
    },
    {
      "name": "maximum-length topic ID and name are accepted",
      "raw": "[{\"topic_id\": \"topic_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\", \"name\": \"nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn\"}]",
      "expected": [
        {
          "topic_id": "topic_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "name": "nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn"
        }
      ]
    },
    {
      "name": "maximum-length name is counted in Unicode code points",
      "raw": "[{\"topic_id\": \"topic_kpis\", \"name\": \"📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊\"}]",
      "expected": [
        {
          "topic_id": "topic_kpis",
          "name": "📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊📊"
        }
      ]
    },
    {
      "name": "single-segment, digit, and multi-segment topic IDs are accepted",
      "raw": "[{\"topic_id\":\"topic_a\",\"name\":\"A\"},{\"topic_id\":\"topic_2026\",\"name\":\"B\"},{\"topic_id\":\"topic_a1_b2_c3\",\"name\":\"C\"}]",
      "expected": [
        {
          "topic_id": "topic_a",
          "name": "A"
        },
        {
          "topic_id": "topic_2026",
          "name": "B"
        },
        {
          "topic_id": "topic_a1_b2_c3",
          "name": "C"
        }
