      "raw": "{\"archetype_id\":\"pitch_deck\",\"name\":\"A\"}"
    },
    {
      "name": "non-object entry",
      "raw": "[\"pitch_deck\"]"
    },
    {
      "name": "null description",
      "raw": "[{\"archetype_id\":\"pitch_deck\",\"name\":\"A\",\"description\":null}]"
    },
    {
      "name": "non-string name",
      "raw": "[{\"archetype_id\":\"pitch_deck\",\"name\":7}]"
    },
    {
      "name": "archetype ID with a trailing line feed",
