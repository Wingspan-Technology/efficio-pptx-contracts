{
  "comment": "Shared TypeScript/Python slide-archetype cases. `null` stands for an absent tag value; a string is stored PowerPoint tag text; an array is an already-decoded value.",
  "registry_cases": [
    {
      "name": "missing registry declares no archetypes",
      "raw": null,
      "expected": []
    },
    {
      "name": "blank registry declares no archetypes",
      "raw": "   ",
      "expected": []
    },
    {
      "name": "empty stored array declares no archetypes",
      "raw": "[]",
      "expected": []
    },
    {
      "name": "empty decoded array declares no archetypes",
      "raw": [],
      "expected": []
    },
    {
      "name": "one definition with an optional description",
      "raw": "[{\"archetype_id\":\"pitch_deck\",\"name\":\"Pitch deck\",\"description\":\"Investor narrative.\"}]",
      "expected": [
        {
          "archetype_id": "pitch_deck",
          "name": "Pitch deck",
          "description": "Investor narrative."
        }
      ]
    },
    {
      "name": "one definition without a description",
      "raw": "[{\"archetype_id\":\"pitch_deck\",\"name\":\"Pitch deck\"}]",
      "expected": [
        {
          "archetype_id": "pitch_deck",
          "name": "Pitch deck"
        }
      ]
    },
    {
      "name": "multiple definitions keep authored order",
      "raw": "[{\"archetype_id\": \"pitch_deck\", \"name\": \"Pitch deck\", \"description\": \"Investor narrative.\"}, {\"archetype_id\": \"quarterly_review\", \"name\": \"Quarterly review\"}, {\"archetype_id\": \"training\", \"name\": \"Training\"}]",
      "expected": [
        {
          "archetype_id": "pitch_deck",
          "name": "Pitch deck",
          "description": "Investor narrative."
        },
        {
          "archetype_id": "quarterly_review",
          "name": "Quarterly review"
        },
        {
          "archetype_id": "training",
          "name": "Training"
        }
      ]
    },
    {
      "name": "an already-decoded array is accepted",
      "raw": [
        {
          "archetype_id": "pitch_deck",
          "name": "Pitch deck",
          "description": "Investor narrative."
        },
        {
          "archetype_id": "quarterly_review",
          "name": "Quarterly review"
        },
        {
          "archetype_id": "training",
          "name": "Training"
        }
      ],
      "expected": [
        {
          "archetype_id": "pitch_deck",
          "name": "Pitch deck",
          "description": "Investor narrative."
        },
        {
          "archetype_id": "quarterly_review",
          "name": "Quarterly review"
        },
        {
          "archetype_id": "training",
          "name": "Training"
        }
      ]
    },
    {
      "name": "names may repeat when archetype IDs are unique",
      "raw": "[{\"archetype_id\":\"pitch_deck\",\"name\":\"Deck\"},{\"archetype_id\":\"training\",\"name\":\"Deck\"}]",
      "expected": [
        {
          "archetype_id": "pitch_deck",
          "name": "Deck"
        },
        {
          "archetype_id": "training",
          "name": "Deck"
        }
      ]
    },
    {
      "name": "names and descriptions are trimmed while IDs stay exact",
      "raw": "[{\"archetype_id\":\"pitch_deck\",\"name\":\"  Pitch deck  \",\"description\":\"  Investor narrative.  \"}]",
      "expected": [
        {
          "archetype_id": "pitch_deck",
          "name": "Pitch deck",
          "description": "Investor narrative."
        }
      ]
    },
    {
      "name": "maximum-length fields are accepted",
      "raw": "[{\"archetype_id\": \"abbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\", \"name\": \"nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn\", \"description\": \"\"}]",
      "expected": [
        {
          "archetype_id": "abbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          "name": "nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn",
          "description": ""
        }
      ]
    },
    {
      "name": "single-segment and multi-segment IDs are accepted",
      "raw": "[{\"archetype_id\":\"a\",\"name\":\"A\"},{\"archetype_id\":\"a1_b2_c3\",\"name\":\"B\"}]",
      "expected": [
        {
          "archetype_id": "a",
          "name": "A"
        },
        {
          "archetype_id": "a1_b2_c3",
          "name": "B"
        }
      ]
    }
  ],
