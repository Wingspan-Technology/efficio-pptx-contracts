{
  "name": "@wingspan-technology/efficio-pptx-contracts",
  "version": "0.2.0",
  "description": "Efficio PPTX contracts and generated TypeScript SDK.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wingspan-Technology/efficio-pptx-contracts.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    "./editor": {
      "types": "./dist/ts/editor.d.ts",
      "import": "./dist/ts/editor.js"
    }
  },
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || >=24.0.0"
  },
  "scripts": {
    "validate:contracts": "tsx scripts/validate-contracts.ts",
    "generate:ts": "tsx scripts/generate-ts-contracts.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.build.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:run": "vitest run",
    "check": "npm run validate:contracts && npm run generate:ts && npm run typecheck && npm test && npm run build",
    "release:build": "./scripts/build-release-artifacts.sh",
    "release:verify": "./scripts/verify-release-artifacts.sh",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.9"
  }
}
